{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "session": {
    "sidebar": "auto",
    "thinking": "hide",
    "scrollbar": true,
    "permissions": "prompt",
    "image_preview": true
  },
  "diffs": {
    "source": "working",
    "wrap": "word"
  },
  "prompt": {
    "paste": "full"
  },
  "theme": {
    "name": "opencode",
    "mode": "system"
  },
  "mouse": true,
  "attention": {
    "sound": false
  },
  "plugins": [
    "/home/james/repos/opencode-goal-plugin",
    {
      "package": "/home/james/repos/computer-use/voice-assistant",
      "options": {
        "recognitionBackend": "sherpa"
      }
    }
  ]
}
