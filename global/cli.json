{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "session": {
    "sidebar": "auto",
    "thinking": "hide",
    "scrollbar": true,
    "permissions": "prompt",
    "image_preview": true
  },
  "diffs": {
    "source": "working",
    "wrap": "word"
  },
  "prompt": {
    "paste": "full"
  },
  "theme": {
    "name": "opencode",
    "mode": "system"
  },
  "mouse": true,
  "attention": {
    "sound": false
  },
  "plugins": [
    "@prevalentware/opencode-goal-plugin@0.1.67"
  ]
}
