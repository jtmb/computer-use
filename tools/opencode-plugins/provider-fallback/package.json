{
  "name": "computer-use-provider-fallback-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Opt-in OpenCode v2 retry fallback with read-only sidebar status.",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "test": "timeout --kill-after=3s 60s node --experimental-strip-types --test --test-timeout=30000 --test-concurrency=1 test/*.test.ts test/*.test.mjs",
    "typecheck": "timeout --kill-after=3s 90s node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.1.1",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/node": "22.18.6",
    "@types/json-schema": "7.0.15",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
}
