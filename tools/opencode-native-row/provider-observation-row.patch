+    latestAssistantMessageID: observation.messageID ?? "unknown",
     status:
       input.status === "running"
         ? "Running"
@@ -52,6 +56,40 @@ export function subagentRow(input: {
   }
 }
 
+function subagentObservation(messages: readonly SessionMessageInfo[]) {
+  const latest = messages.findLast((message) => message.type === "assistant")
+  if (!latest || latest.type !== "assistant") return {}
+
+  const native = record(latest.native)
+  const report = record(native?.modelObservation)
+  const messageID = identifier(latest.id, 256)
+  if (!messageID?.startsWith("msg_")) return {}
+  if (!report || !Object.hasOwn(report, "source") || report.source !== "open-responses") return { messageID }
+
+  const model = field(report, "model", 256)
+  const reasoningEffort = field(report, "reasoningEffort", 64)
+  if (model === invalid || reasoningEffort === invalid) return { messageID }
+  return { model, reasoningEffort, messageID }
+}
+
+const invalid = Symbol("invalid observation field")
+
+function field(value: Record<string, unknown>, key: string, max: number) {
+  if (!Object.hasOwn(value, key)) return undefined
+  return identifier(value[key], max) ?? invalid
+}
+
+function identifier(value: unknown, max: number) {
+  if (typeof value !== "string" || value.length === 0 || value.length > max) return undefined
+  if (/[\s\p{Cc}\p{Cf}]/u.test(value)) return undefined
+  return value
+}
+
+function record(value: unknown): Record<string, unknown> | undefined {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) return undefined
+  return value as Record<string, unknown>
+}
+
 function text(value: unknown) {
   return typeof value === "string" ? value.trim() || undefined : undefined
 }
