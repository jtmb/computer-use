@@ -0,0 +1,306 @@
+/** @jsxImportSource @opentui/solid */
+import { testRender } from "@opentui/solid"
+import { expect, test } from "bun:test"
+import { onMount, Show } from "solid-js"
+import { ScrollBoxRenderable } from "@opentui/core"
+import type { SessionInfo, SessionMessageInfo } from "@opencode/client"
+import { ConfigProvider } from "../src/config"
+import { ClientProvider } from "../src/context/client"
+import { DataProvider, useData } from "../src/context/data"
+import { Keymap } from "../src/context/keymap"
+import { LocationProvider } from "../src/context/location"
+import { RouteProvider, useRoute } from "../src/context/route"
+import { TuiAppProvider } from "../src/context/runtime"
+import { StorageProvider } from "../src/context/storage"
+import { ThemeProvider } from "../src/context/theme"
+import { Composer } from "../src/routes/session/composer"
+import { DialogProvider } from "../src/ui/dialog"
+import { ToastProvider } from "../src/ui/toast"
+import { tmpdir } from "./fixture/fixture"
+import { createApi, createEventStream, createFetch, directory, json } from "./fixture/tui-client"
+import { TestTuiContexts } from "./fixture/tui-environment"
+import { createTuiResolvedConfig } from "./fixture/tui-runtime"
+
+function session(id: string, input: Partial<SessionInfo> = {}): SessionInfo {
+  return {
+    id,
+    parentID: "ses_parent",
+    projectID: "proj_test",
+    title: id,
+    agent: "build",
+    location: { directory },
+    cost: 0,
+    tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+    time: { created: 0, updated: 0 },
+    ...input,
+  }
+}
+
+function launch(sessionID: string, description: string, model: string): SessionMessageInfo {
+  return {
+    type: "assistant",
+    id: `msg_launch_${sessionID}`,
+    agent: "build",
+    model: { providerID: "parent", id: "model" },
+    time: { created: 0 },
+    content: [
+      {
+        type: "tool",
+        id: `call_${sessionID}`,
+        name: "subagent",
+        time: { created: 0 },
+        state: { status: "running", input: { description, model }, metadata: { sessionID } },
+      },
+    ],
+  }
+}
+
+function assistant(id: string, native?: unknown): SessionMessageInfo {
+  return {
+    type: "assistant",
+    id,
+    agent: "build",
+    model: { providerID: "selected-provider", id: "selected-model" },
+    time: { created: 0 },
+    content: [],
+    ...(native === undefined ? {} : { native }),
+  } as SessionMessageInfo
+}
+
+async function fixture(input: {
+  width: number
+  children: SessionInfo[]
+  messages?: Record<string, SessionMessageInfo[]>
+  active?: string[]
+}) {
+  const state = await tmpdir()
+  const sessions = [session("ses_parent", { parentID: undefined }), ...input.children]
+  const messageLists = input.messages ?? {}
+  const events = createEventStream()
+  const calls = createFetch((url) => {
+    if (url.pathname === "/api/session/active")
+      return json({
+        data: Object.fromEntries(
+          (input.active ?? input.children.map((s) => s.id)).map((id) => [id, { type: "running" }]),
+        ),
+      })
+    const current = sessions.find((s) => url.pathname === `/api/session/${s.id}`)
+    if (current) return json({ data: current })
+    const messageSession = sessions.find((s) => url.pathname === `/api/session/${s.id}/message`)
+    if (messageSession) return json({ data: (messageLists[messageSession.id] ?? []).toReversed(), cursor: {} })
+    const interrupt = sessions.find((s) => url.pathname === `/api/session/${s.id}/interrupt`)
+    if (interrupt) return json({ interrupted: true }, { status: 200 })
+  }, events)
+  const ready = Promise.withResolvers<void>()
+  let route!: ReturnType<typeof useRoute>
+  let data!: ReturnType<typeof useData>
+  let closed = 0
+  function Content() {
+    route = useRoute()
+    data = useData()
+    onMount(() => {
+      void Promise.all([
+        ...sessions.map((s) => data.session.sync(s.id)),
+        ...sessions.map((s) => data.session.message.sync(s.id)),
+      ]).then(() => ready.resolve(), ready.reject)
+    })
+    return (
+      <Show when={route.data.type === "session" ? route.data.sessionID : undefined} keyed>
+        {(sessionID) => <Composer sessionID={sessionID} open={true} defaultTab="subagents" onClose={() => closed++} />}
+      </Show>
+    )
+  }
+  const app = await testRender(
+    () => (
+      <TestTuiContexts paths={{ state: state.path, home: state.path }}>
+        <TuiAppProvider value={{ name: "test", version: "test", channel: "test" }}>
+          <StorageProvider>
+            <ConfigProvider config={createTuiResolvedConfig()}>
+              <Keymap.Provider>
+                <ClientProvider api={createApi(calls.fetch)}>
+                  <DataProvider directory={directory}>
+                    <LocationProvider>
+                      <RouteProvider initialRoute={{ type: "session", sessionID: "ses_parent" }}>
+                        <ThemeProvider mode="dark" source={{ discover: async () => ({}) }}>
+                          <ToastProvider>
+                            <DialogProvider>
+                              <Content />
+                            </DialogProvider>
+                          </ToastProvider>
+                        </ThemeProvider>
+                      </RouteProvider>
+                    </LocationProvider>
+                  </DataProvider>
+                </ClientProvider>
+              </Keymap.Provider>
+            </ConfigProvider>
+          </StorageProvider>
+        </TuiAppProvider>
+      </TestTuiContexts>
+    ),
+    { width: input.width, height: 24, kittyKeyboard: true },
+  )
+  await ready.promise
+  await until(() => input.active?.length === 0 || input.children.every((s) => data.session.status(s.id) === "running"))
+  await app.renderOnce()
+  return {
+    ...app,
+    route: () => route.data,
+    closed: () => closed,
+    data,
+    async [Symbol.asyncDispose]() {
+      app.renderer.destroy()
+      await state[Symbol.asyncDispose]()
+    },
+  }
+}
+
+test.each([44, 120])("native Composer rows show bounded response reports and provenance at width %s", async (width) => {
+  await using app = await fixture({
+    width,
+    children: [
+      session("ses_a", {
+        title: "Renamed child",
+        model: { providerID: "chosen", id: "actual", variant: "high" },
+      }),
+    ],
+    messages: {
+      ses_parent: [launch("ses_a", "Inspect storage", "asked/model#xhigh")],
+      ses_a: [
+        assistant("msg_response_17", {
+          modelObservation: {
+            source: "open-responses",
+            model: "r",
+            reasoningEffort: "x",
+          },
+        }),
+      ],
+    },
+  })
+  const frame = app.captureCharFrame()
+  const text = frame.replaceAll("┃", "").replace(/\s+/g, " ")
+  expect(frame).toContain("Task: Inspect storage")
+  expect(frame).toContain("Running")
+  expect(text).toContain("Model (selected): chosen/actual")
+  expect(text).toContain("Variant: high")
+  expect(text).toContain("Model (requested): asked/model#xhigh")
+  expect(text).toContain("Effort: unknown")
+  expect(text).toContain("Execution-effective model/effort: unknown")
+  expect(text).toContain("Response-reported model: r")
+  expect(text).toContain("Response-reported effort: x")
+  expect(text).toContain("Latest message ID: msg_response_17")
+  expect(frame).not.toContain("Renamed child")
+  const row = app.renderer.root.findDescendantById("subagent-row-ses_a")!
+  expect(row.x + row.width).toBeLessThanOrEqual(width)
+  expect(frame.split("\n").find((line) => line.includes("Task:"))).toContain("Running")
+})
+
+test("native Composer does not fall back to an older response report when the latest assistant is unreported", async () => {
+  await using app = await fixture({
+    width: 120,
+    children: [session("ses_a")],
+    messages: {
+      ses_parent: [launch("ses_a", "Latest response", "asked/model#high")],
+      ses_a: [
+        assistant("msg_old", {
+          modelObservation: { source: "open-responses", model: "old-model", reasoningEffort: "high" },
+        }),
+        assistant("msg_latest"),
+      ],
+    },
+  })
+  const text = app.captureCharFrame().replaceAll("┃", "").replace(/\s+/g, " ")
+  expect(text).toContain("Response-reported model: unknown")
+  expect(text).toContain("Response-reported effort: unknown")
+  expect(text).toContain("Latest message ID: msg_latest")
+  expect(text).not.toContain("old-model")
+})
+
+test.each([44, 120])("response-report rows retain scrolling and navigation at width %s", async (width) => {
+  const children = Array.from({ length: 6 }, (_, i) =>
+    session(`ses_${i}`, {
+      title: `Task ${i}`,
+      model: { providerID: "selected", id: `model-${i}`, variant: "high" },
+    }),
+  )
+  await using app = await fixture({
+    width,
+    children,
+    messages: {
+      ses_parent: children.map((child) => launch(child.id, child.title ?? child.id, "requested/model#high")),
+      ...Object.fromEntries(
+        children.map((child, i) => [
+          child.id,
+          [
+            assistant(`msg_${i}`, {
+              modelObservation: {
+                source: "open-responses",
+                model: `model-${i}`,
+                reasoningEffort: "high",
+              },
+            }),
+          ],
+        ]),
+      ),
+    },
+  })
+  app.mockInput.pressArrow("down")
+  await app.renderOnce()
+  await app.renderOnce()
+  await app.renderOnce()
+  const second = app.renderer.root.findDescendantById("subagent-row-ses_1")!
+  await app.mockMouse.click(second.x + 3, second.y)
+  expect(app.route()).toMatchObject({ sessionID: "ses_1" })
+  await app.renderOnce()
+  await app.renderOnce()
+  await app.renderOnce()
+  for (let i = 0; i < 4; i++) app.mockInput.pressArrow("down")
+  await app.renderOnce()
+  const scroll = app.renderer.root.findDescendantById("subagents-list")
+  expect(scroll).toBeInstanceOf(ScrollBoxRenderable)
+  if (!(scroll instanceof ScrollBoxRenderable)) throw new Error("Missing subagents scrollbox")
+  expect(scroll.scrollTop).toBeGreaterThan(5)
+  expect(app.captureCharFrame()).toContain("Task: Task 5")
