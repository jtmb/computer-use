     model: model ? `${model.providerID}/${model.id}` : "unknown",
@@ -39,6 +40,9 @@ export function subagentRow(input: {
     // A header is a selection, not proof of the provider's effective model or reasoning configuration.
     effort: "unknown",
     execution: "unknown",
+    responseModel: observation.model ?? "unknown",
