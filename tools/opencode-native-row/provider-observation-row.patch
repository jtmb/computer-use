diff --git a/packages/tui/test/subagent-row-observation.test.ts b/packages/tui/test/subagent-row-observation.test.ts
new file mode 100644
index 0000000..4e7c611
--- /dev/null
+++ b/packages/tui/test/subagent-row-observation.test.ts
@@ -0,0 +1,239 @@
+import { expect, test } from "bun:test"
+import type { SessionInfo, SessionMessageInfo } from "@opencode/client"
+import { subagentRow } from "../src/routes/session/composer/subagent-row"
+
+function child(input: Partial<SessionInfo> = {}): SessionInfo {
+  return {
+    id: "ses_child",
+    parentID: "ses_parent",
+    projectID: "proj_test",
+    title: "Inspect storage",
+    agent: "build",
+    location: { directory: "/tmp/opencode/packages/tui" },
+    cost: 0,
+    tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+    time: { created: 0, updated: 0 },
+    ...input,
+  }
+}
+
+function assistant(id: string, native?: unknown, content: unknown[] = []): SessionMessageInfo {
+  return {
+    type: "assistant",
+    id,
+    agent: "build",
+    model: { providerID: "selected-provider", id: "selected-model" },
+    time: { created: 0 },
+    content,
+    ...(native === undefined ? {} : { native }),
+  } as SessionMessageInfo
+}
+
+function row(messages: readonly SessionMessageInfo[], session = child()) {
+  return subagentRow({ session, status: "idle", messages })
+}
+
+test("keeps producer-safe punctuation without inventing a narrower identifier format", () => {
+  const model = "future$model@rev=2"
+  const reasoningEffort = "ultra~v3"
+  expect(row([assistant("msg_latest", { modelObservation: { source: "open-responses", model, reasoningEffort } })])).toMatchObject({
+    responseModel: model,
+    responseEffort: reasoningEffort,
+    latestAssistantMessageID: "msg_latest",
+  })
+})
+
+test.each(["invalid\u0000id", "not-a-message"])("does not promote an observation without safe message provenance: %s", (id) => {
+  expect(row([assistant(id, { modelObservation: { source: "open-responses", model: "reported", reasoningEffort: "high" } })])).toMatchObject({
+    responseModel: "unknown",
+    responseEffort: "unknown",
+    latestAssistantMessageID: "unknown",
+  })
+})
+
+test("accepts only bounded open-responses identifiers without enum assumptions", () => {
+  const model = `future_${"m".repeat(249)}`
+  const reasoningEffort = `future-${"e".repeat(57)}`
+  const messages = [assistant("msg_latest", { modelObservation: { source: "open-responses", model, reasoningEffort } })]
+  expect(row(messages)).toMatchObject({
+    responseModel: model,
+    responseEffort: reasoningEffort,
+    latestAssistantMessageID: "msg_latest",
+  })
+})
+
+test("keeps omitted response fields unknown and accepts future-safe identifiers", () => {
+  expect(
+    row([
+      assistant("msg_latest", {
+        modelObservation: { source: "open-responses", model: "future_β/model+v3" },
+      }),
+    ]),
+  ).toMatchObject({
+    responseModel: "future_β/model+v3",
+    responseEffort: "unknown",
+    latestAssistantMessageID: "msg_latest",
+  })
+  expect(
+    row([
+      assistant("msg_effort", {
+        modelObservation: { source: "open-responses", reasoningEffort: "future-effort" },
+      }),
+    ]),
+  ).toMatchObject({
+    responseModel: "unknown",
+    responseEffort: "future-effort",
+    latestAssistantMessageID: "msg_effort",
+  })
+})
+
+test.each([
+  [undefined],
+  [null],
+  [true],
+  ["openai"],
+  ["open-responses "],
+  [[]],
+  [{ model: "future-model" }],
+])(
+  "rejects malformed or non-open-responses observation sources: %s",
+  (observation) => {
+    expect(
+      row([assistant("msg_latest", { modelObservation: observation })]),
+    ).toMatchObject({
+      responseModel: "unknown",
+      responseEffort: "unknown",
+      latestAssistantMessageID: "msg_latest",
+    })
+  },
+)
+
+test.each([
+  ["model", null],
+  ["model", true],
+  ["model", 1],
+  ["model", []],
+  ["model", {}],
+  ["model", ""],
+  ["model", "has whitespace"],
+  ["model", "nonbreaking\u00a0space"],
+  ["model", "line\nbreak"],
+  ["model", "control\u0007"],
+  ["model", "format\u200bchar"],
+  ["model", "line\u2028separator"],
+  ["model", "m".repeat(257)],
+  ["reasoningEffort", null],
+  ["reasoningEffort", false],
+  ["reasoningEffort", 2],
+  ["reasoningEffort", []],
+  ["reasoningEffort", {}],
+  ["reasoningEffort", "has whitespace"],
+  ["reasoningEffort", "line\nbreak"],
+  ["reasoningEffort", "control\u0007"],
+  ["reasoningEffort", "format\u200bchar"],
+  ["reasoningEffort", "e".repeat(65)],
+] as const)("rejects malformed or unsafe %s values without partial promotion", (field, value) => {
+  const observation = { source: "open-responses", model: "safe-model", reasoningEffort: "high", [field]: value }
+  expect(row([assistant("msg_latest", { modelObservation: observation })])).toMatchObject({
+    responseModel: "unknown",
+    responseEffort: "unknown",
+    latestAssistantMessageID: "msg_latest",
+  })
+})
+
+test("the newest assistant message is authoritative; an older report is never reused", () => {
+  expect(
+    row([
+      assistant("msg_old", {
+        modelObservation: { source: "open-responses", model: "old-model", reasoningEffort: "high" },
+      }),
+      assistant("msg_latest"),
+    ]),
+  ).toMatchObject({
+    responseModel: "unknown",
+    responseEffort: "unknown",
+    latestAssistantMessageID: "msg_latest",
+  })
+})
+
+test("a malformed latest report never falls back to an older valid observation", () => {
+  expect(
+    row([
+      assistant("msg_old", {
+        modelObservation: { source: "open-responses", model: "old-model", reasoningEffort: "high" },
+      }),
+      assistant("msg_latest", {
+        modelObservation: { source: "open-responses", model: "unsafe model", reasoningEffort: "xhigh" },
+      }),
+    ]),
+  ).toMatchObject({
+    responseModel: "unknown",
+    responseEffort: "unknown",
+    latestAssistantMessageID: "msg_latest",
+  })
+})
+
+test("missing cached assistant history leaves response data and message provenance unknown", () => {
+  expect(row([])).toMatchObject({
+    responseModel: "unknown",
+    responseEffort: "unknown",
+    latestAssistantMessageID: "unknown",
+  })
+})
+
+test("an assistant without a report stays unknown even when user or tool metadata looks similar", () => {
+  const user = {
+    type: "user",
+    id: "msg_user",
+    text: "Inspect storage",
+    time: { created: 0 },
+    native: { modelObservation: { source: "open-responses", model: "user-model", reasoningEffort: "xhigh" } },
+  } as SessionMessageInfo
+  const tool = {
+    type: "tool",
+    id: "call_tool",
+    name: "subagent",
+    time: { created: 0 },
+    state: {
+      status: "completed",
+      input: {},
+      metadata: { modelObservation: { source: "open-responses", model: "tool-model", reasoningEffort: "xhigh" } },
+      content: [],
+    },
+  }
+  expect(row([user, assistant("msg_latest", undefined, [tool])])).toMatchObject({
+    responseModel: "unknown",
+    responseEffort: "unknown",
+    latestAssistantMessageID: "msg_latest",
+  })
+})
+
+test("reported response metadata remains separate from requested and selected fields", () => {
+  const session = child({ model: { providerID: "selected-provider", id: "selected-model", variant: "high" } })
+  const request = { description: "Inspect storage", prompt: undefined, model: "requested/model#xhigh" }
+  expect(
+    subagentRow({
+      session,
+      dispatch: request,
+      status: "running",
+      messages: [
+        assistant("msg_latest", {
+          modelObservation: {
+            source: "open-responses",
+            model: "response/model-vNext",
+            reasoningEffort: "future-effort",
+          },
+        }),
+      ],
+    }),
+  ).toMatchObject({
+    model: "selected-provider/selected-model",
+    variant: "high",
+    requested: "requested/model#xhigh",
+    effort: "unknown",
+    execution: "unknown",
+    responseModel: "response/model-vNext",
+    responseEffort: "future-effort",
+    latestAssistantMessageID: "msg_latest",
+  })
+})
