+// This is the provider's final-response report, not proof of execution: transport
+// hooks can rewrite a response before the protocol observes it.
+const safeReportedIdentifier = (value: unknown, maxLength: number) =>
+  typeof value === "string" &&
+  value.length > 0 &&
+  value.length <= maxLength &&
+  !/[\s\p{Cc}\p{Cf}]/u.test(value)
+    ? value
+    : undefined
+
+const responseModelObservation = (response: Event["response"]) => {
+  if (!response) return undefined
+  const model = safeReportedIdentifier(response.model, 256)
+  const reasoning = ProviderShared.isRecord(response.reasoning) ? response.reasoning : undefined
+  const reasoningEffort = safeReportedIdentifier(reasoning?.effort, 64)
+  if (model === undefined && reasoningEffort === undefined) return undefined
+  return {
+    source: "open-responses" as const,
+    ...(model === undefined ? {} : { model }),
+    ...(reasoningEffort === undefined ? {} : { reasoningEffort }),
+  }
+}
