+test("execution events move the same child through unknown, running and all terminal outcomes", async () => {
+  const current = session("ses_live", { title: "Live task" })
+  await using app = await fixture({ width: 120, active: [], children: [current] })
+  app.mockInput.pressKey("a", { ctrl: true })
+  await app.renderOnce()
+  expect(app.captureCharFrame()).toContain("Idle (outcome unknown)")
+  for (const [index, outcome] of ["succeeded", "failed", "interrupted"].entries()) {
+    const started = index * 2 + 1
+    app.events.emit({
+      id: `evt_start_${index}`,
+      created: started,
+      type: "session.execution.started",
+      durable: { aggregateID: current.id, seq: started, version: 1 },
+      data: { sessionID: current.id },
+      location: { directory },
+    })
+    await until(() => app.data.session.status(current.id) === "running")
+    app.mockInput.pressKey("a", { ctrl: true })
+    await app.renderOnce()
+    expect(app.captureCharFrame()).toContain("Task: Live task")
+    expect(app.captureCharFrame()).toContain("Running")
+    expect(app.captureCharFrame()).not.toContain("Succeeded")
+    expect(app.captureCharFrame()).not.toContain("Failed")
+    expect(app.captureCharFrame()).not.toContain("Interrupted")
+    app.mockInput.pressKey("d", { ctrl: true })
+    await until(() => app.interrupted.length === index + 1)
+    expect(app.interrupted.at(-1)).toBe(current.id)
+    const ended = started + 1
+    current.outcome = outcome as SessionInfo["outcome"]
+    current.time = { created: 0, updated: ended, idle: ended }
+    const base = {
+      id: `evt_end_${index}`,
+      created: ended,
+      durable: { aggregateID: current.id, seq: ended, version: 1 as const },
+      location: { directory },
+    }
+    app.events.emit(
+      outcome === "succeeded"
+        ? { ...base, type: "session.execution.succeeded", data: { sessionID: current.id } }
+        : outcome === "failed"
+          ? {
+              ...base,
+              type: "session.execution.failed",
+              data: { sessionID: current.id, error: { type: "unknown", message: "Fixture failure" } },
+            }
+          : { ...base, type: "session.execution.interrupted", data: { sessionID: current.id, reason: "user" } },
+    )
+    await until(
+      () => app.data.session.status(current.id) === "idle" && app.data.session.get(current.id)?.outcome === outcome,
+    )
+    await app.renderOnce()
+    expect(app.captureCharFrame()).toContain("No active subagents")
+    app.mockInput.pressKey("a", { ctrl: true })
+    await app.renderOnce()
+    expect(app.captureCharFrame()).toContain(outcome[0].toUpperCase() + outcome.slice(1))
+  }
+})
