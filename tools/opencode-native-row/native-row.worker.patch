diff --git a/packages/tui/test/subagent-row.test.ts b/packages/tui/test/subagent-row.test.ts
new file mode 100644
index 0000000..7384dfd
--- /dev/null
+++ b/packages/tui/test/subagent-row.test.ts
@@ -0,0 +1,170 @@
+import { expect, test } from "bun:test"
+import type { SessionInfo, SessionMessageInfo, SessionMessageAssistantTool } from "@opencode/client"
+import { subagentDispatch, subagentRow } from "../src/routes/session/composer/subagent-row"
+
+export function child(id = "ses_child", input: Partial<SessionInfo> = {}): SessionInfo {
+  return {
+    id,
+    parentID: "ses_parent",
+    projectID: "proj_test",
+    title: "Inspect storage",
+    agent: "build",
+    location: { directory: "/tmp/opencode/packages/tui" },
+    cost: 0,
+    tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+    time: { created: 0, updated: 0 },
+    ...input,
+  }
+}
+
+export function dispatch(
+  sessionID: string,
+  input: Extract<SessionMessageAssistantTool["state"], { status: "running" }>["input"] = {},
+  state?: SessionMessageAssistantTool["state"],
+): SessionMessageInfo {
+  return {
+    type: "assistant",
+    id: `msg_dispatch_${sessionID}`,
+    agent: "build",
+    model: { providerID: "parent", id: "parent" },
+    time: { created: 0 },
+    content: [
+      {
+        type: "tool",
+        id: `call_${sessionID}`,
+        name: "subagent",
+        time: { created: 0 },
+        state: state ?? { status: "running", input, metadata: { sessionID } },
+      },
+    ],
+  }
+}
+
+test("dispatch joins exact child IDs and selects the latest continuation", () => {
+  const messages = [
+    dispatch("ses_child", { description: "Original" }),
+    dispatch("ses_sibling", { description: "Other child", model: "other/model#high" }),
+    dispatch("ses_child", { description: "Continue storage", model: "asked/model#high" }),
+  ]
+  expect(subagentDispatch(messages, "ses_child")).toEqual({
+    description: "Continue storage",
+    model: "asked/model#high",
+    prompt: undefined,
+  })
+  expect(subagentDispatch(messages, "ses_sibling")?.description).toBe("Other child")
+  expect(subagentDispatch(messages, "ses_missing")).toBeUndefined()
+})
+
+test("output/progress identity wins over mismatched input and unbound streaming calls", () => {
+  expect(
+    subagentDispatch([dispatch("ses_actual", { sessionID: "ses_wrong", description: "Actual" })], "ses_wrong"),
+  ).toBeUndefined()
+  expect(
+    subagentDispatch(
+      [dispatch("ses_child", {}, { status: "streaming", input: '{"description":"Partial"' })],
+      "ses_child",
+    ),
+  ).toBeUndefined()
+  expect(
+    subagentDispatch(
+      [
+        dispatch(
+          "",
+          {},
+          { status: "running", input: { sessionID: "ses_child", description: "Resumed" }, metadata: {} },
+        ),
+      ],
+      "ses_child",
+    )?.description,
+  ).toBe("Resumed")
+})
+
+test("completed tool output still supplies dispatch metadata without treating its prose as status", () => {
+  const request = subagentDispatch(
+    [
+      dispatch(
+        "ses_child",
+        {},
+        {
+          status: "completed",
+          input: { description: "Verify completion", model: "asked/model#high" },
+          metadata: { sessionID: "ses_child", status: "completed" },
+          content: [{ type: "text", text: "The subagent failed, succeeded, and is running" }],
+        },
+      ),
+    ],
+    "ses_child",
+  )
+  expect(request?.description).toBe("Verify completion")
+  expect(subagentRow({ session: child(), dispatch: request, status: "idle", messages: [] }).status).toBe(
+    "Idle (outcome unknown)",
+  )
+})
+
+test.each(["fast", "high"])("selected variant %s never inherits the requested model or implies effort", (variant) => {
+  const request = subagentDispatch([dispatch("ses_child", { model: "asked/model#xhigh" })], "ses_child")
+  const selected = subagentRow({
+    session: child("ses_child", { model: { providerID: "chosen", id: "actual", variant } }),
+    dispatch: request,
+    status: "running",
+    messages: [],
+  })
+  expect(selected).toMatchObject({
+    model: "chosen/actual",
+    variant,
+    requested: "asked/model#xhigh",
+    effort: "unknown",
+    execution: "unknown",
+  })
+  expect(subagentRow({ session: child(), dispatch: request, status: "idle", messages: [] })).toMatchObject({
+    model: "unknown",
+    variant: "unknown",
+    effort: "unknown",
+    requested: "asked/model#xhigh",
+  })
+})
+
+test.each([
+  ["Dispatch task", "Session title", "Prompt task", "Dispatch task"],
+  [undefined, "Session title", "Prompt task", "Session title"],
+  [undefined, "   ", "Prompt task", "Prompt task"],
+  [undefined, "@build subagent", "Prompt task", "Prompt task"],
+  [undefined, undefined, undefined, "Subagent task"],
+])("task falls back from %s / %s / %s", (description, title, prompt, expected) => {
+  expect(
+    subagentRow({
+      session: child("ses_child", { title }),
+      dispatch: { description, prompt, model: undefined },
+      status: "idle",
+      messages: [],
+    }).task,
+  ).toBe(expected)
+})
+
+test("cached user excerpt is bounded and whitespace-normalized", () => {
+  const row = subagentRow({
+    session: child("ses_child", { title: undefined }),
+    status: "idle",
+    messages: [
+      {
+        type: "user",
+        id: "msg_task",
+        time: { created: 0 },
+        text: "You are a subagent spawned by another session.\nInspect\n storage " + "x".repeat(150),
+      },
+    ],
+  })
+  expect(row.task).toStartWith("Inspect storage ")
+  expect(row.task.length).toBeLessThanOrEqual(100)
+})
+
+test.each([
+  [undefined, "Idle (outcome unknown)"],
+  ["succeeded", "Succeeded"],
+  ["failed", "Failed"],
+  ["interrupted", "Interrupted"],
+] as const)("canonical running state overrides previous %s outcome", (outcome, expected) => {
+  const session = child("ses_child", { outcome, time: { created: 0, updated: 2, idle: 1 } })
+  expect(subagentRow({ session, status: "idle", messages: [] }).status).toBe(expected)
+  expect(subagentRow({ session, status: "running", messages: [] }).status).toBe("Running")
+})
