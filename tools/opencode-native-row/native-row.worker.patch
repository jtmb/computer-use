@@ -0,0 +1,56 @@
+import type { SessionInfo, SessionMessageInfo } from "@opencode/client"
+
+export function subagentDispatch(messages: readonly SessionMessageInfo[], sessionID: string) {
+  for (const message of messages.toReversed()) {
+    if (message.type !== "assistant") continue
+    for (const part of message.content.toReversed()) {
+      if (part.type !== "tool" || part.name !== "subagent" || part.state.status === "streaming") continue
+      const metadata = part.state.metadata
+      // Progress/output identifies new children; input.sessionID identifies continuations only.
+      const id = text(metadata?.sessionID) ?? text(part.state.input.sessionID)
+      if (id !== sessionID) continue
+      return {
+        description: text(part.state.input.description),
+        prompt: text(part.state.input.prompt),
+        model: text(part.state.input.model),
+      }
+    }
+  }
+}
+
+export function subagentRow(input: {
+  session: SessionInfo
+  status: "running" | "idle"
+  dispatch?: ReturnType<typeof subagentDispatch>
+  messages: readonly SessionMessageInfo[]
+}) {
+  const title = text(input.session.title?.replace(/@(\w+) subagent/, ""))
+  const prompt = input.dispatch?.prompt ?? input.messages.find((message) => message.type === "user")?.text
+  const preamble = "You are a subagent spawned by another session."
+  const excerpt = prompt?.startsWith(preamble) ? prompt.slice(preamble.length) : prompt
+  const task = input.dispatch?.description ?? title ?? text(excerpt)?.slice(0, 100) ?? "Subagent task"
+  const model = input.session.model
+  return {
+    task: task.replace(/\s+/g, " "),
+    model: model ? `${model.providerID}/${model.id}` : "unknown",
+    variant: model ? (model.variant ?? "not set") : "unknown",
+    requested: input.dispatch?.model,
+    // A header is a selection, not proof of the provider's effective model or reasoning configuration.
+    effort: "unknown",
+    execution: "unknown",
+    status:
+      input.status === "running"
+        ? "Running"
+        : input.session.outcome === "succeeded"
+          ? "Succeeded"
+          : input.session.outcome === "failed"
+            ? "Failed"
+            : input.session.outcome === "interrupted"
+              ? "Interrupted"
+              : "Idle (outcome unknown)",
+  }
+}
+
+function text(value: unknown) {
+  return typeof value === "string" ? value.trim() || undefined : undefined
+}
