{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "opencode-ingress-source-only-template",
    "namespace": "choose-existing-app-namespace"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app.kubernetes.io/name": "replace-with-verified-opencode-pod-label"
      }
    },
    "policyTypes": [
      "Ingress"
    ],
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "tailscale"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": "replace-me"
          }
        ]
      }
    ]
  }
}
