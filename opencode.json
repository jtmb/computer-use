{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "/home/james/repos/opencode-goal-plugin",
      "options": {
        "goal_engine": "enhanced",
        "engine_config_path": "/home/james/repos/computer-use/opencode.json",
        "engine_package": "/home/james/repos/opencode-goal-plugin"
      }
    },
    "-opencode.goal",
    "./tools/self-learning"
  ],
  "skills": [
    "./.opencode/skills"
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": [
          "./scripts/github-mcp.sh"
        ],
        "disabled": false,
        "timeout": {
          "startup": 30000
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "./scripts/playwright-mcp.sh"
        ],
        "disabled": false,
        "timeout": {
          "startup": 90000
        }
      }
    }
  }
}
