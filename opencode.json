{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@prevalentware/opencode-goal-plugin@0.1.67"
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": [
          "./scripts/github-mcp.sh"
        ],
        "disabled": false,
        "timeout": {
          "startup": 30000
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "./scripts/playwright-mcp.sh"
        ],
        "disabled": false,
        "timeout": {
          "startup": 90000
        }
      }
    }
  }
}
